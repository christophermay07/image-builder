# Packer template for {{ inventory_hostname }}
# Generated by image-builder pipeline

packer {
  required_plugins {
    amazon = {
      version = "= {{ packer_plugin_amazon_version }}"
      source  = "github.com/hashicorp/amazon"
    }
    ansible = {
      version = "= {{ packer_plugin_ansible_version }}"
      source  = "github.com/hashicorp/ansible"
    }
  }
}

variable "source_ami" {
  type    = string
  default = "{{ source_ami }}"
}

variable "instance_type" {
  type    = string
  default = "{{ packer_instance_type }}"
}

variable "region" {
  type    = string
  default = "{{ aws_region }}"
}

variable "ami_name" {
  type    = string
  default = "{{ vm_name }}-{{ '{{' }} timestamp {{ '}}' }}"
}

source "amazon-ebs" "windows" {
  ami_name      = var.ami_name
  instance_type = var.instance_type
  region        = var.region
  source_ami    = var.source_ami

  communicator   = {{ packer_communicator | to_json }}
  winrm_username = "{{ packer_winrm_username }}"
  winrm_password = "{{ packer_winrm_password }}"
  winrm_use_ssl  = true
  winrm_insecure = true

  user_data_file = "{{ packer_template_dir }}/{{ vm_name }}-userdata.ps1"

  tags = {
{% for key, value in ami_base_tags.items() %}
    {{ key }} = "{{ value }}"
{% endfor %}
  }
}

build {
  sources = ["source.amazon-ebs.windows"]

  # Apply STIG hardening (no Sysprep; that runs last after the scan).
  provisioner "ansible" {
    command = "{{ builder_ansible_bin }}/ansible-playbook"
    ansible_env_vars = [
{% for key, value in builder_ansible_environment.items() %}
      {{ (key ~ '=' ~ value) | to_json }},
{% endfor %}
    ]
    playbook_file = "{{ packer_template_dir }}/{{ vm_name }}-harden.yml"
    use_proxy     = false
    extra_arguments = [
      "-e", "ansible_winrm_server_cert_validation=ignore",
      "-e", "@{{ builder_ansible_workspace }}/hardening.yml"
    ]
  }

  # Run pre-seal compliance scan via PowerSTIG (build-time diagnostic).
  # The post-AMI validation scan runs separately after the AMI is registered.
  provisioner "ansible" {
    command = "{{ builder_ansible_bin }}/ansible-playbook"
    ansible_env_vars = [
{% for key, value in builder_ansible_environment.items() %}
      {{ (key ~ '=' ~ value) | to_json }},
{% endfor %}
    ]
    playbook_file = "{{ packer_template_dir }}/{{ vm_name }}-scan.yml"
    use_proxy     = false
    extra_arguments = [
      "-e", "ansible_winrm_server_cert_validation=ignore",
      "-e", "@{{ builder_ansible_workspace }}/scan.yml"
    ]
  }

  # Download pre-seal scan results from the guest to the builder.
  provisioner "file" {
    source      = {{ (compliance_output_dir ~ '\\') | to_json }}
    destination = "{{ report_output_dir }}/{{ vm_name }}/"
    direction   = "download"
  }

  # Generalize and shut down the instance.
  provisioner "ansible" {
    command = "{{ builder_ansible_bin }}/ansible-playbook"
    ansible_env_vars = [
{% for key, value in builder_ansible_environment.items() %}
      {{ (key ~ '=' ~ value) | to_json }},
{% endfor %}
    ]
    playbook_file = "{{ packer_template_dir }}/{{ vm_name }}-sysprep.yml"
    use_proxy     = false
    extra_arguments = [
      "-e", "ansible_winrm_server_cert_validation=ignore"
    ]
  }

  post-processor "manifest" {
    output     = "{{ packer_log_dir }}/{{ vm_name }}-manifest.json"
    strip_path = true
  }
}
