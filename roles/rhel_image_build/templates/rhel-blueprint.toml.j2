# RHEL {{ os_version }} Blueprint - Generated by image-builder pipeline
# Target: {{ inventory_hostname }}
# Profile: {{ profile }}

name = "{{ vm_name }}"
description = "RHEL {{ os_version }} {{ profile }} - FIPS enabled, STIG hardened"
version = "{{ image_version }}"
distro = "rhel-{{ os_version | regex_replace('\\.', '') }}"

{% for pkg in profile_linux_packages | default([]) %}
[[packages]]
name = "{{ pkg }}"
version = "*"

{% endfor %}
[customizations]
hostname = ""

# FIPS must be enabled at build time for NIST compliance.
[customizations.fips]
enabled = true

# Kernel parameters
# - fips=1: enforce FIPS mode (also enabled via [customizations.fips])
# - console=ttyS0,115200n8: direct boot output to the first serial port
#   (115200 baud, 8N1). AWS, Azure, and GCP all present their serial
#   console on ttyS0 at this baud rate.
[customizations.kernel]
append = "fips=1 console=ttyS0,115200n8"

# Services enabled/disabled at boot.
# Enabled list always includes cloud-init; profiles can add more.
# Disabled list is empty by default; profiles can disable specific services.
[customizations.services]
enabled = {{ profile_linux_enabled_services | to_json }}
{% if profile_linux_disabled_services | default([]) | length > 0 %}
disabled = {{ profile_linux_disabled_services | to_json }}
{% endif %}

# SELinux mode. Defaults to "enforcing" (STIG requirement). The database profile
# sets this to "permissive" because certain database workloads require it.
[customizations.selinux]
mode = "{{ selinux_mode | default('enforcing') }}"

# Firewall
[customizations.firewall]
[customizations.firewall.services]
enabled = ["ssh"]

# STIG-compliant partition layout: separate /boot, LVM for everything else.
# Sizes are minimums; cloud-init growpart expands the root volume at deploy.
# Mount points and sizes are driven by blueprint_filesystem_layout (see inventory
# group_vars/all_profiles/linux.yml).
{% for mountpoint, minsize in (blueprint_filesystem_layout | default({})) | dictsort %}
[[customizations.filesystem]]
mountpoint = "{{ mountpoint }}"
minsize = "{{ minsize }}"
{% endfor %}

# OpenSCAP STIG remediation applied during the compose.
# Image Builder runs pre-first-boot remediation using scap-security-guide.
[customizations.openscap]
datastream = "{{ stig_content_dir }}/{{ stig_datastream }}"
profile_id = "{{ stig_profile }}"

{% if stig_unselected_rules | default([]) | length > 0 or stig_selected_rules | default([]) | length > 0 %}
# Tailoring: deselect rules from the base STIG profile, or select additional
# rules from outside it. Each change should have a documented justification.
[customizations.openscap.tailoring]
{% if stig_unselected_rules | default([]) | length > 0 %}
unselected = {{ stig_unselected_rules | to_json }}
{% endif %}
{% if stig_selected_rules | default([]) | length > 0 %}
selected = {{ stig_selected_rules | to_json }}
{% endif %}
{% endif %}

# Cloud-specific chrony NTP configuration.
# Each cloud provider has its own time source (AWS link-local, Azure PTP
# refclock, GCP metadata server). The config comes from the cloud
# dimension group_vars (cloud_aws.yml, cloud_azure.yml, cloud_gcp.yml).
{% if chrony_config is defined %}
[[customizations.files]]
path = "/etc/chrony.conf"
mode = "0644"
data = """
{{ chrony_config }}"""
{% endif %}

# Cloud-specific datasource configuration for cloud-init.
# Datasource list comes from the cloud dimension group_vars.
{% set extra_cloud_configs = cloud_init_extra_configs | default([]) %}
{% if extra_cloud_configs | selectattr('filename', 'equalto', '99-datasources.cfg') | list | length == 0 %}
[[customizations.files]]
path = "/etc/cloud/cloud.cfg.d/99-datasources.cfg"
mode = "0644"
data = """
datasource_list:
{% for ds in cloud_init_datasources | default([]) %}
  - {{ ds }}
{% endfor %}
"""
{% endif %}

# Additional cloud-init settings are present before the offline compliance scan.
# Keep the last entry for repeated filenames, including an explicit replacement of 99-datasources.cfg.
{% for config in extra_cloud_configs | reverse | unique(attribute='filename', case_sensitive=true) | reverse %}
[[customizations.files]]
path = {{ ('/etc/cloud/cloud.cfg.d/' ~ config.filename) | to_json(ensure_ascii=False) }}
mode = "0644"
# Quoted TOML strings preserve YAML newlines, quotes, and backslashes without interpreting them as TOML syntax.
data = {{ config.content | to_json(ensure_ascii=False) | replace('\u007f', '\\u007f') }}

{% endfor %}

# Yum repositories baked into the final image (/etc/yum.repos.d/).
# os_major is optional; when set it can be a single value ("9") or a list (["8", "9"]).
# [x] | flatten normalizes both forms into a list for the membership check.
{% for repo in blueprint_yum_repos | default([]) %}
{% if repo.os_major is not defined or os_major in ([repo.os_major] | flatten | map('string') | list) %}
[[customizations.repositories]]
id = "{{ repo.id }}"
{% if repo.name is defined %}
name = "{{ repo.name }}"
{% endif %}
baseurl = "{{ repo.baseurl }}"
gpgcheck = {{ repo.gpgcheck | default(true) | bool | lower }}
{% if repo.gpgkey is defined %}
gpgkey = "{{ repo.gpgkey }}"
{% endif %}
enabled = {{ repo.enabled | default(true) | bool | lower }}

{% endif %}
{% endfor %}
