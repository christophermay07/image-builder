---
profile: production
skip_list:
  # Some generated/template playbooks omit task names for brevity
  - name[missing]
  # Role names should not be filesystem paths
  - role-name[path]
  # Variables should be prefixed with the role name
  # For this project, variables are intentionally shared across roles
  - var-naming[no-role-prefix]
exclude_paths:
  - .git/
  - tests/
  # This helper requires windows_stig_role from the build's hardening.yml payload, unavailable to standalone linting.
  # syntax-check cannot be suppressed per line. The build syntax-checks this playbook with its actual provider input
  # before starting Packer, so exclude it here instead of supplying a lint-only provider selection.
  - roles/windows_image_build/files/windows-provider.yml
kinds:
  - playbook: "playbooks/*.yml"
  - vars: "inventory/group_vars/**/*.yml"
  - vars: "inventory/host_vars/**/*.yml"
  - tasks: "roles/*/tasks/*.yml"
  - handlers: "roles/*/handlers/*.yml"
  - meta: "roles/*/meta/*.yml"
  - vars: "roles/*/defaults/*.yml"
  - vars: "roles/*/vars/*.yml"
